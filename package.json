{
  "name": "dsh-annotate-it",
  "version": "1.5.7",
  "description": "Annotate chats and documents in DeepSeek Harness: mark passages, stack comments and quick replies, and send the whole review as one message.",
  "license": "MIT",
  "author": "dsh-annotate-it contributors (fork of dsh-quote-reply)",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
